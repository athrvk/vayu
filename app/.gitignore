# Node.js dependencies
node_modules/

# Build outputs
dist/
dist-electron/
build/
out/
.vite/
.webpack/

# Compiled config artifacts (sources are the .ts; the emitted .js/.d.ts
# would shadow vite.config.ts since Vite resolves .js before .ts)
vite.config.js
vite.config.d.ts

# Electron packaging
release/
package/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
# Written by a sharded run (`pnpm test --shard=1/2 --reporter=json ...`) and by
# the manifest step that reads it; CI keeps them only as an artifact.
vitest-shard.json
shard-*.txt
full-suite-*.txt

# Temporary files
*.tmp
tmp/
temp/

# Build fixture written inside app/ by monaco-setup.contributions.test.ts, so
# `monaco-editor`'s exports map resolves the way the real build resolves it.
# The test removes it; this is for the run that dies before its finally.
.monaco-worker-fixture-*/

# Engine binaries (bundled at build time)
resources/bin/vayu-engine
resources/bin/vayu-cli
