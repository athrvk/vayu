registry=https://registry.npmjs.org/
only-built-dependencies=electron,electron-winstaller,esbuild
# Do not resolve a version published in the last seven days: a compromised
# release is usually pulled within that window, and nothing here needs a
# package the day it ships. The unit is minutes, and the key is
# `minimum-release-age` - `min-release-age=7` (what this file carried until
# #1335) is not a setting pnpm reads, so it delayed nothing.
minimum-release-age=10080
# Rolldown is exempt because its version is not ours to pick: Vite depends on
# an exact `rolldown`, which depends on an exact `@rolldown/binding-*` per
# platform, and a package with one matching version cannot wait - pnpm fails
# the whole resolution with ERR_PNPM_NO_MATURE_MATCHING_VERSION rather than
# choosing an older one. The delay still applies to Vite itself, which is the
# dependency this repo actually chooses.
minimum-release-age-exclude[]=rolldown
minimum-release-age-exclude[]=@rolldown/binding-*
