{
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		/*
		 * Stated, not inherited. TypeScript 5 defaults this to `false` and
		 * TypeScript 7 defaults it to `true`, so an unset `strict` meant the main
		 * process was checked one way by the build (5.x) and the other by the
		 * type-check gate (7.x) - the only divergence a full two-compiler diff of
		 * this tree turned up, and it was worth exactly one error.
		 *
		 * `true` because it is what the repo already believed: `app/CLAUDE.md`
		 * states "strict TypeScript" as the convention, `tsconfig.json` sets it for
		 * the renderer, and `electron/` is written as if it held - the `!`
		 * assertions on guard-proved values through `mcp/tools.ts` are no-ops
		 * without it. Turning it on cost one real fix, not a migration.
		 */
		"strict": true,
		/*
		 * NOT NodeNext, however much the main process looks like it wants it.
		 * The package is `"type": "module"`, so NodeNext classifies preload.ts -
		 * a script with no imports, only `require()` - as ESM and stamps
		 * `export {}` onto the emit. Electron loads a sandboxed preload as
		 * CommonJS, so that marker makes the preload fail to load outright:
		 * `electronAPI` is never exposed, and the renderer silently loses the
		 * title bar (TitleBar returns null without it) and the platform stamp.
		 * Adopting NodeNext means renaming preload.ts to preload.cts first.
		 */
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"target": "ES2020",
		/*
		 * Stated because `ErrorOptions` is not in the ES2020 lib and
		 * `new Error(message, { cause })` needs it - the longer note is in
		 * tsconfig.json. The rest of the list is what `target: ES2020` already
		 * implied through `lib.es2020.full.d.ts`, so nothing else changes here;
		 * tsconfig.electron-test.json narrows it the same way for the same reason.
		 */
		"lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
		"outDir": "dist-electron",
		"rootDir": "electron",
		"noEmit": false
	},
	"include": ["electron"],
	/*
	 * Tests are not part of the main process - emitting them shipped vitest
	 * imports into `dist-electron`, and `resolve.test.ts` reaches across to
	 * `app/src/` (see tsconfig.electron-test.json, which checks them instead).
	 */
	"exclude": ["electron/**/*.test.ts"]
}
