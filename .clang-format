# Formatting for the C++ engine (engine/src, engine/include, engine/tests).
#
# Derived from the code, not imported: every setting below was chosen by
# measuring the bulk-format diff it produces over the 285 non-vendor engine
# translation units and keeping whichever value the engine's existing code
# already agrees with. Issue #886 has the full table. Two conclusions are worth
# keeping next to the config, because they read as mistakes otherwise:
#
#   - `ColumnLimit: 80` with `PenaltyExcessCharacter: 1`. The penalty is what
#     makes 80 a target rather than a wall: 90% of engine lines are already
#     under 80, and the ~6% that are over are almost all under 100. Raising the
#     limit instead (90/100/120) makes the diff two to three times *worse*,
#     because a wider limit re-joins line breaks the code chose by hand.
#   - `ContinuationIndentWidth: 0`. Unusual, and the code is written to it -
#     wrapped arguments sit at the enclosing block indent. Setting it to 4
#     rewrites nearly every engine source, at roughly four times the cost of
#     the whole bulk-format commit, and it is not the style anyone here writes,
#     including in the last 60 commits. The table is in #907, which is where
#     changing it gets decided - not here, and not quietly.
#
# clang-format 19 is the pinned version (CONTRIBUTING.md); the bulk-format
# commit in .git-blame-ignore-revs was produced by it.
#
# engine/vendor/ carries `DisableFormat: true` and is never touched.

Language: Cpp
BasedOnStyle: LLVM

# Indentation: 4 spaces, no tabs, no extra indent for namespaces or access
# modifiers, and wrapped lines at the enclosing block indent.
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: 0
ContinuationIndentWidth: 0
ConstructorInitializerIndentWidth: 0

# Wrapping: never realign to an open bracket or an operator - the engine wraps
# to the block indent instead. Declaration parameters go all-on-one-line or
# one-per-line; call arguments stay bin-packed.
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignEscapedNewlines: Left
AllowAllParametersOfDeclarationOnNextLine: false
BinPackParameters: false
BreakBeforeTernaryOperators: false
Cpp11BracedListStyle: false

# Column budget. See the note above: the limit is soft by design.
ColumnLimit: 80
PenaltyExcessCharacter: 1
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyBreakComment: 100
PenaltyBreakFirstLessLess: 0
PenaltyBreakString: 100
PenaltyReturnTypeOnItsOwnLine: 20

# Single-line forms: only `case X: return y;` collapses.
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: None

# Comments and includes are left alone. Both carry meaning clang-format cannot
# see: the engine's block comments are hand-wrapped prose that reflowing
# scrambles, and include order here is deliberate (a header that must come
# first for a macro or a platform guard is not alphabetically first).
ReflowComments: false
SortIncludes: Never
CommentPragmas: ''

# Spacing.
PointerAlignment: Left
SpaceBeforeParens: Always
SpacesInContainerLiterals: false
AlignConsecutiveAssignments: Consecutive
MaxEmptyLinesToKeep: 2
