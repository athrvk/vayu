#!/bin/bash

# Run clang-tidy on changed C++ files
echo "Running clang-tidy on changed files..."

# Add common Homebrew paths for LLVM on macOS to ensure clang-tidy is found
if [ -d "/opt/homebrew/opt/llvm/bin" ]; then
    export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
elif [ -d "/usr/local/opt/llvm/bin" ]; then
    export PATH="/usr/local/opt/llvm/bin:$PATH"
fi

# The oldest clang-tidy that can parse engine/.clang-tidy. `ExcludeHeaderFilterRegex`
# landed in LLVM 19; an older binary rejects the whole config file, so it lints
# *nothing* and still exits 0 - a hook that scans an empty set and reports success
# (issue #659 item 4). Ubuntu 24.04 ships 18 by default, so this is the common case,
# not an exotic one.
MIN_CLANG_TIDY_MAJOR=19

# Get list of changed C++ files
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.(cpp|hpp|c|h)$")

if [ -z "$FILES" ]; then
    exit 0
fi

# Check if clang-tidy is installed
if ! command -v clang-tidy &> /dev/null; then
    echo "clang-tidy not found. Skipping linting."
    exit 0
fi

# Version probe, before any file is linted. Said loudly and once: the failure this
# replaces was silent, and a contributor on 18 had no way to tell "clean" from
# "never ran". The `Lint changed engine sources` step in
# .github/workflows/pr-tests.yml lints the same files on clang-tidy 19 before a
# pull request can merge, so this stays a skip rather than a refusal to commit -
# a missing or old local toolchain costs a contributor nothing but the early
# warning.
CLANG_TIDY_VERSION=$(clang-tidy --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
CLANG_TIDY_MAJOR=${CLANG_TIDY_VERSION%%.*}
if [ -z "$CLANG_TIDY_MAJOR" ] || [ "$CLANG_TIDY_MAJOR" -lt "$MIN_CLANG_TIDY_MAJOR" ] 2>/dev/null; then
    echo "WARNING: clang-tidy ${CLANG_TIDY_VERSION:-(unknown version)} cannot read engine/.clang-tidy."
    echo "         It uses ExcludeHeaderFilterRegex, which needs clang-tidy >= ${MIN_CLANG_TIDY_MAJOR}."
    echo "         NOTHING WAS LINTED. Install a newer clang-tidy (e.g. 'apt install clang-tidy-19')"
    echo "         or rely on CI, which lints the same files on clang-tidy 19."
    exit 0
fi

# What makes this hook a gate rather than a report. clang-tidy is invoked once
# per file and each invocation's status is kept, so one bad file does not stop
# the rest from being linted and does not get lost either - the old loop
# discarded every status and ended in an unconditional `exit 0`, so a
# contributor with the hook installed and a current clang-tidy could commit code
# it had just flagged (issue #885). The status is only meaningful because
# `engine/.clang-tidy` sets `WarningsAsErrors: '*'`; with that empty, clang-tidy
# prints its findings and exits 0.
STATUS=0

# Run clang-tidy
for FILE in $FILES; do
    # Skip vendor files
    if [[ "$FILE" == *"vendor/"* ]]; then
        continue
    fi

    # Check if file exists
    if [ ! -f "$FILE" ]; then
        continue
    fi

    echo "Linting $FILE..."
    # We need compilation database for clang-tidy to work correctly with includes
    # Assuming build directory is engine/build
    # --allow-no-checks is for engine/src/runtime/, whose .clang-tidy sets
    # `Checks: '-*'`. Without it clang-tidy treats an empty check list as a usage
    # error and exits 1, so now that this loop reads the exit status the one
    # directory that is meant to be exempt would be the only one that refuses a
    # commit. Needs clang-tidy 19, which the probe above has already required.
    #
    # `--extra-arg=-Wno-ignored-gch` is this hook's alone, and is passed here
    # rather than set as `ExtraArgs` in engine/.clang-tidy, where it used to be
    # (issue #912). This hook lints against whatever build tree you already
    # have. The engine builds with a precompiled header, and on a GCC build that
    # `.gch` is not one clang can read, so clang-tidy replaying the compile
    # command says "precompiled header ... was ignored because it is not a clang
    # PCH file" on every file. It then falls back to including the header as
    # text and analyses exactly the same translation unit, so the diagnostic is
    # noise about the build tree rather than a fact about the code - and a hook
    # that prints it once per staged file is a hook people stop reading.
    #
    # It has to be a compiler flag: with -Werror in the compile command clang
    # raises it as a hard error before any check filter is consulted, so a
    # `-clang-diagnostic-ignored-gch` entry in the check list does nothing.
    #
    # In engine/.clang-tidy it was worse than unnecessary, it was breaking:
    # that file is read by CI too, `compile_commands.json` holds no entry for a
    # header, and on the command clang-tidy synthesises for a file it cannot
    # look up the flag arrives in input position - "no such file or directory:
    # '-Wno-ignored-gch'" - failing the engine job for any pull request that
    # touched a `.hpp`. CI never needed it: it regenerates
    # `compile_commands.json` with `-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON`,
    # which is the fix that holds for every compiler - macOS produces a *clang*
    # PCH that Homebrew's clang 19 still rejects as "a newer PCH format", which
    # no `-Wno-` flag covers. This hook does not do that, because reconfiguring
    # someone's build tree from a git hook would throw away their next
    # incremental build.
    if [ -f "engine/build/compile_commands.json" ]; then
        clang-tidy --allow-no-checks --extra-arg=-Wno-ignored-gch \
            -p engine/build "$FILE" || STATUS=1
    else
        echo "Warning: compile_commands.json not found in engine/build. clang-tidy might report false positives."
        # Fallback: try to include common directories
        clang-tidy --allow-no-checks "$FILE" -- -Iengine/include -Iengine/vendor/quickjs-ng || STATUS=1
    fi
done

if [ "$STATUS" -ne 0 ]; then
    echo
    echo "clang-tidy reported findings in the staged files above; the commit was refused."
    echo "Fix them, or mark a deliberate exception with a NOLINT comment naming the check."
    echo
    echo "This hook lints whole staged files, so it also reports findings that were"
    echo "already there. CI gates the lines your pull request changes, so a finding on"
    echo "code you did not touch will not block the merge (issue #902)."
    echo "To commit anyway: git commit --no-verify"
    exit 1
fi

exit 0
