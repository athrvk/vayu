{
  "name": "vayu-engine",
  "description": "High-performance API execution engine",
  "homepage": "https://github.com/vayu/vayu",
  "license": "MIT",
  "dependencies": [
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "http2",
        "non-http",
        "openssl"
      ]
    },
    "libsodium",
    "nlohmann-json",
    "ryml",
    "valijson",
    {
      "name": "cpp-httplib",
      "features": [
        "openssl"
      ]
    },
    "gtest",
    {
      "name": "sqlite3",
      "features": [
        "json1"
      ]
    },
    "sqlite-orm"
  ],
  "builtin-baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4"
}
