{
  "$comment": "Cross-language conformance fixture for {{variable}} resolution (issue #226). Read by BOTH the engine gtest suite (request_composer_test.cpp, via VAYU_ENGINE_SOURCE_DIR) and the app's vitest suite (app/src/lib/variable-resolution.conformance.test.ts) - the engine owns execution-time resolution, the renderer's copy is preview-only, and this table is what keeps the two from drifting. Each scope is a raw stored-variables bag exactly as it sits in SQLite, so deliberately malformed entries (non-string values, absent or non-boolean 'enabled') exercise the D17 rules on both sides: a definition with absent 'enabled' is enabled, and a non-string 'value' reads as empty string. 'chain' is the collection ancestor chain, root first.",
  "dynamicVariableNames": [
    "$guid",
    "$randomUUID",
    "$timestamp",
    "$isoTimestamp",
    "$randomInt",
    "$randomAlphaNumeric",
    "$randomBoolean",
    "$randomEmail",
    "$randomFirstName",
    "$randomLastName",
    "$randomFullName",
    "$randomCompanyName",
    "$randomUrl",
    "$randomIP",
    "$randomPassword"
  ],
  "cases": [
    {
      "name": "environment beats collection chain beats globals",
      "scopes": {
        "globals": { "host": { "value": "globals.test", "enabled": true } },
        "chain": [{ "host": { "value": "chain.test", "enabled": true } }],
        "environment": { "host": { "value": "env.test", "enabled": true } }
      },
      "input": "https://{{host}}/api",
      "expected": "https://env.test/api"
    },
    {
      "name": "within the chain, leaf overrides root",
      "scopes": {
        "chain": [
          { "host": { "value": "root.test", "enabled": true } },
          { "host": { "value": "leaf.test", "enabled": true } }
        ]
      },
      "input": "{{host}}",
      "expected": "leaf.test"
    },
    {
      "name": "globals resolve when nothing shadows them",
      "scopes": { "globals": { "token": { "value": "g-123", "enabled": true } } },
      "input": "Bearer {{token}}",
      "expected": "Bearer g-123"
    },
    {
      "name": "a disabled higher-precedence definition falls back to the next scope",
      "scopes": {
        "chain": [{ "host": { "value": "chain.test", "enabled": true } }],
        "environment": { "host": { "value": "env.test", "enabled": false } }
      },
      "input": "{{host}}",
      "expected": "chain.test"
    },
    {
      "name": "a name whose every definition is disabled is unknown, so it stays literal",
      "scopes": {
        "globals": { "gone": { "value": "a", "enabled": false } },
        "environment": { "gone": { "value": "b", "enabled": false } }
      },
      "input": "[{{gone}}]",
      "expected": "[{{gone}}]"
    },
    {
      "name": "D17: absent 'enabled' counts as enabled",
      "scopes": { "environment": { "host": { "value": "implicit.test" } } },
      "input": "{{host}}",
      "expected": "implicit.test"
    },
    {
      "name": "D17: a non-boolean 'enabled' counts as enabled",
      "scopes": { "environment": { "host": { "value": "loose.test", "enabled": "yes" } } },
      "input": "{{host}}",
      "expected": "loose.test"
    },
    {
      "name": "D17: a numeric stored value reads as empty string",
      "scopes": { "environment": { "port": { "value": 8080, "enabled": true } } },
      "input": "p={{port}}",
      "expected": "p="
    },
    {
      "name": "D17: an object stored value reads as empty string",
      "scopes": {
        "environment": { "blob": { "value": { "nested": true }, "enabled": true } }
      },
      "input": "b={{blob}}",
      "expected": "b="
    },
    {
      "name": "D17: a null stored value reads as empty string",
      "scopes": { "environment": { "nil": { "value": null, "enabled": true } } },
      "input": "n={{nil}};still={{nil}}",
      "expected": "n=;still="
    },
    {
      "name": "D17: one malformed definition does not discard its siblings",
      "scopes": {
        "environment": {
          "bad": { "value": 42, "enabled": true },
          "good": { "value": "kept", "enabled": true }
        }
      },
      "input": "{{good}}/{{bad}}",
      "expected": "kept/"
    },
    {
      "name": "an ordinary unknown name keeps its braces (issue #1009)",
      "scopes": { "environment": { "known": { "value": "x", "enabled": true } } },
      "input": "a={{missing}}&b={{known}}",
      "expected": "a={{missing}}&b=x"
    },
    {
      "name": "an unknown $name keeps its braces (issue #186)",
      "scopes": {},
      "input": "id={{$notAGenerator}}",
      "expected": "id={{$notAGenerator}}"
    },
    {
      "name": "a data.* name keeps its braces - only a scenario iteration binds it (issue #402)",
      "scopes": { "environment": { "known": { "value": "x", "enabled": true } } },
      "input": "https://api.test/{{data.id}}?k={{known}}",
      "expected": "https://api.test/{{data.id}}?k=x"
    },
    {
      "name": "a variable named data.id does not answer for the reserved column (issue #402)",
      "scopes": { "environment": { "data.id": { "value": "shadowed", "enabled": true } } },
      "input": "{{data.id}}",
      "expected": "{{data.id}}"
    },
    {
      "name": "$vu and $iteration keep their braces - only the iteration that sends binds them (issue #994)",
      "scopes": { "environment": { "known": { "value": "x", "enabled": true } } },
      "input": "https://api.test/u{{$vu}}/i{{$iteration}}?k={{known}}",
      "expected": "https://api.test/u{{$vu}}/i{{$iteration}}?k=x"
    },
    {
      "name": "a variable named $vu does not answer for the reserved identity (issue #994)",
      "scopes": { "environment": { "$vu": { "value": "shadowed", "enabled": true } } },
      "input": "{{$vu}}",
      "expected": "{{$vu}}"
    },
    {
      "name": "a $name that only looks like the identity follows the unknown-$name rule (issue #994)",
      "scopes": {},
      "input": "a={{$vus}}&b={{$iterations}}",
      "expected": "a={{$vus}}&b={{$iterations}}"
    },
    {
      "name": "the data. prefix alone names no column and follows the unknown-name rule",
      "scopes": {},
      "input": "a{{data.}}b{{data}}c",
      "expected": "a{{data.}}b{{data}}c"
    },
    {
      "name": "a user-defined variable named $guid beats the generator",
      "scopes": { "environment": { "$guid": { "value": "pinned-guid", "enabled": true } } },
      "input": "{{$guid}}",
      "expected": "pinned-guid"
    },
    {
      "name": "whitespace around the name is trimmed",
      "scopes": { "environment": { "host": { "value": "trim.test", "enabled": true } } },
      "input": "{{ host }}",
      "expected": "trim.test"
    },
    {
      "name": "a value containing {{other}} resolves through it (issue #1009)",
      "scopes": {
        "environment": {
          "a": { "value": "{{b}}", "enabled": true },
          "b": { "value": "resolved-b", "enabled": true }
        }
      },
      "input": "{{a}}",
      "expected": "resolved-b"
    },
    {
      "name": "the layered baseUrl every imported environment is written with",
      "scopes": {
        "globals": { "protocol": { "value": "https", "enabled": true } },
        "chain": [{ "baseUrl": { "value": "{{protocol}}://{{host}}", "enabled": true } }],
        "environment": { "host": { "value": "api.example.test", "enabled": true } }
      },
      "input": "{{baseUrl}}/orders",
      "expected": "https://api.example.test/orders"
    },
    {
      "name": "nesting resolves through several levels",
      "scopes": {
        "environment": {
          "one": { "value": "<{{two}}>", "enabled": true },
          "two": { "value": "[{{three}}]", "enabled": true },
          "three": { "value": "end", "enabled": true }
        }
      },
      "input": "{{one}}",
      "expected": "<[end]>"
    },
    {
      "name": "a token inside a value that nothing defines stays literal, like any other",
      "scopes": { "environment": { "a": { "value": "x={{nope}}", "enabled": true } } },
      "input": "{{a}}",
      "expected": "x={{nope}}"
    },
    {
      "name": "a two-name cycle stops with the token literal instead of looping",
      "scopes": {
        "environment": {
          "a": { "value": "A{{b}}", "enabled": true },
          "b": { "value": "B{{a}}", "enabled": true }
        }
      },
      "input": "{{a}}",
      "expected": "AB{{a}}"
    },
    {
      "name": "a value referring to itself stops at its own token",
      "scopes": { "environment": { "loop": { "value": "x{{loop}}", "enabled": true } } },
      "input": "{{loop}}",
      "expected": "x{{loop}}"
    },
    {
      "name": "the same name twice side by side is two expansions, not a cycle",
      "scopes": {
        "environment": {
          "a": { "value": "[{{b}}]", "enabled": true },
          "b": { "value": "v", "enabled": true }
        }
      },
      "input": "{{a}}{{a}}",
      "expected": "[v][v]"
    },
    {
      "name": "a chain longer than the depth bound keeps what it resolved and leaves the rest literal",
      "scopes": {
        "environment": {
          "d0": { "value": "0{{d1}}", "enabled": true },
          "d1": { "value": "1{{d2}}", "enabled": true },
          "d2": { "value": "2{{d3}}", "enabled": true },
          "d3": { "value": "3{{d4}}", "enabled": true },
          "d4": { "value": "4{{d5}}", "enabled": true },
          "d5": { "value": "5{{d6}}", "enabled": true },
          "d6": { "value": "6{{d7}}", "enabled": true },
          "d7": { "value": "7{{d8}}", "enabled": true },
          "d8": { "value": "8{{d9}}", "enabled": true },
          "d9": { "value": "9", "enabled": true }
        }
      },
      "input": "{{d0}}",
      "expected": "012345678{{d9}}"
    },
    {
      "name": "empty braces never match and stay literal",
      "scopes": { "environment": { "x": { "value": "1", "enabled": true } } },
      "input": "{{}}{{x}}",
      "expected": "{{}}1"
    },
    {
      "name": "nested braces never match",
      "scopes": { "environment": { "x": { "value": "1", "enabled": true } } },
      "input": "{{a{{x}}b}}",
      "expected": "{{a1b}}"
    },
    {
      "name": "repeated occurrences each substitute",
      "scopes": { "environment": { "x": { "value": "v", "enabled": true } } },
      "input": "{{x}}-{{x}}-{{x}}",
      "expected": "v-v-v"
    },
    {
      "name": "an empty stored value substitutes as empty",
      "scopes": { "environment": { "empty": { "value": "", "enabled": true } } },
      "input": "[{{empty}}]",
      "expected": "[]"
    },
    {
      "name": "a name with inner spaces is a lookup, not a syntax error",
      "scopes": { "environment": { "a b": { "value": "spaced", "enabled": true } } },
      "input": "{{a b}}",
      "expected": "spaced"
    },
    {
      "name": "the raw string is substituted, never the typed value",
      "scopes": {
        "environment": {
          "n": { "value": "007", "enabled": true, "type": "number" },
          "j": { "value": "{\"k\": 1}", "enabled": true, "type": "json" }
        }
      },
      "input": "{{n}}|{{j}}",
      "expected": "007|{\"k\": 1}"
    }
  ]
}
