      "name": "3.x - a $ref-ed request body, merged path and operation parameters, a tag folder",
      "document": "{\n  \"openapi\": \"3.0.3\",\n  \"info\": {\n    \"title\": \"Pet Store\"\n  },\n  \"paths\": {\n    \"/pets/{petId}\": {\n      \"parameters\": [\n        {\n          \"name\": \"petId\",\n          \"in\": \"path\",\n          \"required\": true,\n          \"schema\": {\n            \"type\": \"string\"\n          }\n        },\n        {\n          \"name\": \"verbose\",\n          \"in\": \"query\",\n          \"schema\": {\n            \"type\": \"boolean\"\n          }\n        },\n        {\n          \"name\": \"X-Trace\",\n          \"in\": \"header\",\n          \"schema\": {\n            \"type\": \"string\",\n            \"default\": \"off\"\n          }\n        }\n      ],\n      \"get\": {\n        \"operationId\": \"getPet\",\n        \"summary\": \"Get a pet\",\n        \"description\": \"Reads one pet.\",\n        \"tags\": [\n          \"pets\"\n        ],\n        \"parameters\": [\n          {\n            \"name\": \"verbose\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"description\": \"Long form\",\n            \"schema\": {\n              \"type\": \"boolean\"\n            }\n          },\n          {\n            \"name\": \"status\",\n            \"in\": \"query\",\n            \"example\": \"available\"\n          },\n          {\n            \"name\": \"X-Request-Id\",\n            \"in\": \"header\",\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          },\n          {\n            \"name\": \"Authorization\",\n            \"in\": \"header\",\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          },\n          {\n            \"name\": \"session\",\n            \"in\": \"cookie\",\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"ok\"\n          }\n        }\n      },\n      \"put\": {\n        \"operationId\": \"putPet\",\n        \"tags\": [\n          \"pets\"\n        ],\n        \"requestBody\": {\n          \"$ref\": \"#/components/requestBodies/PetBody\"\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"ok\"\n          }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"requestBodies\": {\n      \"PetBody\": {\n        \"content\": {\n          \"application/json\": {\n            \"schema\": {\n              \"$ref\": \"#/components/schemas/Pet\"\n            }\n          }\n        }\n      }\n    },\n    \"schemas\": {\n      \"Pet\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\"\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"example\": \"Rex\"\n          },\n          \"weight\": {\n            \"type\": \"number\",\n            \"example\": 4\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"available\",\n              \"sold\"\n            ]\n          },\n          \"parent\": {\n            \"$ref\": \"#/components/schemas/Pet\"\n          }\n        }\n      }\n    }\n  }\n}",
