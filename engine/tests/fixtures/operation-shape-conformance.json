{
  "description": "The path shapes a request URL and an OpenAPI path reduce to (issue #638, moved engine-side by #761). It was a cross-language conformance table while the renderer reduced these shapes too; the renderer stopped splitting a request URL when the export moved (#855) and stopped reducing a spec path when the spec diff did (#854), so engine/tests/operation_match_test.cpp is its one reader. The cases are kept for what each says about whether two paths describe the same endpoint - a divergence here reaches a user as a bind that matches nothing.",
  "readers": {
    "requestUrls": "engine only (split_request_url, request_path_shape)",
    "specPaths": "engine only (spec_path_shape)",
    "shapeKeys": "engine only (operation_shape_key)"
  },
  "requestUrls": [
    {
      "name": "the import's own spelling: a variable stands in for the whole origin",
      "url": "{{baseUrl}}/pets",
      "origin": "{{baseUrl}}",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "an absolute URL",
      "url": "https://api.example.com/pets",
      "origin": "https://api.example.com",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "a schemeless host",
      "url": "api.example.com/pets",
      "origin": "api.example.com",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "a host with a port",
      "url": "http://localhost:9876/pets",
      "origin": "http://localhost:9876",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "the query and the fragment are not part of what a URL addresses",
      "url": "{{baseUrl}}/pets?limit=10#top",
      "origin": "{{baseUrl}}",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "both template syntaxes flatten to one placeholder",
      "url": "{{baseUrl}}/pets/{{petId}}/toys",
      "origin": "{{baseUrl}}",
      "path": "/pets/{{petId}}/toys",
      "shape": "/pets/{}/toys"
    },
    {
      "name": "a trailing slash is not a different endpoint",
      "url": "{{baseUrl}}/pets/",
      "origin": "{{baseUrl}}",
      "path": "/pets/",
      "shape": "/pets"
    },
    {
      "name": "the root survives the trailing-slash rule",
      "url": "{{baseUrl}}/",
      "origin": "{{baseUrl}}",
      "path": "/",
      "shape": "/"
    },
    {
      "name": "an origin on its own states no path - not the root",
      "url": "{{baseUrl}}",
      "origin": "{{baseUrl}}",
      "path": null,
      "shape": null
    },
    {
      "name": "nothing at all",
      "url": "",
      "origin": null,
      "path": null,
      "shape": null
    },
    {
      "name": "a relative path states no origin, and gains the leading slash",
      "url": "pets/42",
      "origin": null,
      "path": "/pets/42",
      "shape": "/pets/42"
    },
    {
      "name": "a variable that is only part of the first segment is not the origin",
      "url": "{{stage}}.example.com/pets",
      "origin": "{{stage}}.example.com",
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "name": "an unclosed brace is text, not a placeholder",
      "url": "{{baseUrl}}/pets/{petId",
      "origin": "{{baseUrl}}",
      "path": "/pets/{petId",
      "shape": "/pets/{petId"
    },
    {
      "name": "a Postman :name path variable is a placeholder like {{name}} (issue #1764)",
      "url": "{{baseUrl}}/pets/:petId/toys/:toyId.json",
      "origin": "{{baseUrl}}",
      "path": "/pets/:petId/toys/:toyId.json",
      "shape": "/pets/{}/toys/{}.json"
    },
    {
      "name": "a port colon is the origin's and a mid-segment colon is text",
      "url": "http://localhost:8080/v1/ops/x:cancel",
      "origin": "http://localhost:8080",
      "path": "/v1/ops/x:cancel",
      "shape": "/v1/ops/x:cancel"
    }
  ],
  "specPaths": [
    {
      "path": "/pets",
      "shape": "/pets"
    },
    {
      "path": "/pets/{petId}",
      "shape": "/pets/{}"
    },
    {
      "path": "/pets/{id}",
      "shape": "/pets/{}"
    },
    {
      "path": "/pets/{petId}/toys/{toyId}",
      "shape": "/pets/{}/toys/{}"
    },
    {
      "path": "/pets/",
      "shape": "/pets"
    },
    {
      "path": "/",
      "shape": "/"
    },
    {
      "path": "/pets/{petId",
      "shape": "/pets/{petId"
    },
    {
      "path": "/pets/{{a}",
      "shape": "/pets/{{}"
    },
    {
      "path": "/pets/{{{a}}}",
      "shape": "/pets/{{}}"
    },
    {
      "path": "/users/:id",
      "shape": "/users/{}"
    },
    {
      "path": "/users/:id.json/x:cancel",
      "shape": "/users/{}.json/x:cancel"
    }
  ],
  "shapeKeys": [
    {
      "method": "GET",
      "pathShape": "/pets/{}",
      "key": "GET /pets/{}"
    },
    {
      "method": "get",
      "pathShape": "/pets/{}",
      "key": "GET /pets/{}"
    },
    {
      "method": "Delete",
      "pathShape": "/",
      "key": "DELETE /"
    }
  ]
}
