  "divergences": [
    {"name": "format date", "schema": {"format": "date"}, "value": "2024-13-01", "ajv": true, "native": false, "why": "ajv 6 checks formats in its default `fast` mode, a shape match that takes any two digits for a month and a day; jsonSchema checks the calendar, as ajv's `format: 'full'` does."},
    {"name": "format date", "schema": {"format": "date"}, "value": "2024-02-30", "ajv": true, "native": false, "why": "ajv 6 checks formats in its default `fast` mode, a shape match that takes any two digits for a month and a day; jsonSchema checks the calendar, as ajv's `format: 'full'` does."},
    {"name": "format time", "schema": {"format": "time"}, "value": "25:00:00Z", "ajv": true, "native": false, "why": "ajv 6's `fast` time takes any two digits for an hour; jsonSchema checks the range, as ajv's `format: 'full'` does."},
    {"name": "format time", "schema": {"format": "time"}, "value": "03:04:05", "ajv": true, "native": false, "why": "ajv 6 leaves a time's offset optional in both its format modes; jsonSchema follows RFC 3339's full-time, which requires one."},
    {"name": "multipleOf decimal", "schema": {"multipleOf": 0.01}, "value": 0.07, "ajv": false, "native": true, "why": "ajv 6 divides in binary floating point (0.07 / 0.01 is 7.000000000000001, not an integer) unless `multipleOfPrecision` is set; jsonSchema answers the decimal question."},
    {"name": "multipleOf decimal", "schema": {"multipleOf": 0.01}, "value": 19.99, "ajv": false, "native": true, "why": "ajv 6 divides in binary floating point (0.07 / 0.01 is 7.000000000000001, not an integer) unless `multipleOfPrecision` is set; jsonSchema answers the decimal question."}
